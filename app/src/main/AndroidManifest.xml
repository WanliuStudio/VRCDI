<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.vrcdevicecheck.osc">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 应用内更新：下载完成后交给系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 心率手环：标准 BLE 心率服务（0x180D） -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 目标 SDK 30，Android 11 及以下/兼容模式下扫描 BLE 仍需要位置权限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 检测"当前前台应用"：签名级权限，只能由用户在系统设置里手动授予，代码里会引导跳转 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ 包可见性：检测 root 管理器与 Shizuku 是否安装 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.vvb2060.magisk" />
        <package android:name="io.github.huskydg.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="me.bmax.apatch" />
        <!-- 前台应用检测需要能看到 VRChat 一体机版 -->
        <package android:name="com.vrchat.oculus.quest" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VRCDI">

        <!-- 首次启动引导：选语言 + OSC 图文教程；也可以在设置里当教程打开 -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.VRCDI.Onboarding" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VRCDI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HeartRateActivity"
            android:exported="false"
            android:label="@string/heart_rate_title" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ReportIntervalActivity"
            android:exported="false"
            android:label="@string/settings_interval" />

        <activity
            android:name=".WeatherCityActivity"
            android:exported="false"
            android:label="@string/settings_weather_city" />

        <activity
            android:name=".CitySearchActivity"
            android:exported="false"
            android:label="@string/search_title" />

        <activity
            android:name=".WorldCityActivity"
            android:exported="false"
            android:label="@string/world_title" />

        <activity
            android:name=".QWeatherSettingsActivity"
            android:exported="false"
            android:label="@string/qweather_title" />

        <activity
            android:name=".DeviceTableSettingsActivity"
            android:exported="false"
            android:label="@string/settings_device_table" />

        <activity
            android:name=".AppTableSettingsActivity"
            android:exported="false"
            android:label="@string/settings_app_table" />

        <activity
            android:name=".CpuMapSettingsActivity"
            android:exported="false"
            android:label="@string/settings_cpu_map" />

        <activity
            android:name=".ThemeSettingsActivity"
            android:exported="false"
            android:label="@string/theme_title" />

        <activity
            android:name=".UpdateSettingsActivity"
            android:exported="false"
            android:label="@string/settings_update" />

        <!-- 应用内更新：把下载好的 APK 以 content:// 交给系统安装器 -->
        <provider
            android:name=".update.ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 通知使用权挂载点：只用于读取媒体会话（歌名/歌手/进度），不读取通知内容 -->
        <service
            android:name=".media.MediaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ReporterService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Shizuku 官方要求的 Provider，用于接收 binder -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:ignore="ExportedContentProvider" />
    </application>

</manifest>
