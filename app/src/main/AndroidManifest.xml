<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.vrcdevicecheck.osc">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 应用内更新：下载完成后交给系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 检测"当前前台应用"：签名级权限，只能由用户在系统设置里手动授予，代码里会引导跳转 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ 包可见性：检测 root 管理器与 Shizuku 是否安装 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.vvb2060.magisk" />
        <package android:name="io.github.huskydg.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="me.bmax.apatch" />
        <!-- 前台应用检测需要能看到 VRChat 一体机版 -->
        <package android:name="com.vrchat.oculus.quest" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VRCDI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VRCDI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置" />

        <activity
            android:name=".DeviceTableSettingsActivity"
            android:exported="false"
            android:label="设备表设置" />

        <activity
            android:name=".AppTableSettingsActivity"
            android:exported="false"
            android:label="应用表设置" />

        <activity
            android:name=".CpuMapSettingsActivity"
            android:exported="false"
            android:label="CPU 映射表设置" />

        <activity
            android:name=".ThemeSettingsActivity"
            android:exported="false"
            android:label="主题" />

        <activity
            android:name=".UpdateSettingsActivity"
            android:exported="false"
            android:label="软件更新设置" />

        <!-- 应用内更新：把下载好的 APK 以 content:// 交给系统安装器 -->
        <provider
            android:name=".update.ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".service.ReporterService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Shizuku 官方要求的 Provider，用于接收 binder -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:ignore="ExportedContentProvider" />
    </application>

</manifest>
