# 统一换行符，避免 Windows 上提交后整个仓库显示"全部改动"
* text=auto

*.java   text
*.xml    text
*.gradle text
*.properties text
*.md     text
*.json   text

# Shell 脚本在 Linux/CI 上必须是 LF，否则 gradlew 跑不起来
*.sh     text eol=lf
gradlew  text eol=lf
*.bat    text eol=crlf

# 二进制文件不要做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.jar  binary
*.apk  binary
*.aab  binary
